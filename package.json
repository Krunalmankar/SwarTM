{
  "name": "swartm-website",
  "version": "1.0.0",
  "private": true,
  "description": "SwarTM marketing website: ServiceNow AI transformation.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/csp-header.mjs && node scripts/verify-build.mjs && html-validate \"dist/**/*.html\" && node scripts/seo-audit.mjs && node scripts/size-report.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "node scripts/verify-build.mjs && html-validate \"dist/**/*.html\" && node scripts/seo-audit.mjs",
    "size": "node scripts/size-report.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "html-validate": "^11.16.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
