root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Windows batch files must use CRLF or cmd.exe can misread them.
[*.{cmd,bat}]
end_of_line = crlf

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
