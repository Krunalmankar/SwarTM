---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import Icon from '../ui/Icon.astro';
import { mainNav, navIdForPath, site } from '../../config/site';

const current = navIdForPath(Astro.url.pathname);
---

<header class="site-header">
  <nav class="nav container" aria-label="Main" data-nav>
    <a class="brand" href="/">
      <Image
        src={logo}
        alt=""
        width={52}
        height={36}
        densities={[1, 2]}
        loading="eager"
        class="brand__mark"
      />
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__tagline">{site.tagline}</span>
      </span>
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="visually-hidden" data-nav-label>
        Open menu
      </span>
      <Icon name="menu" size={24} strokeWidth={2} class="nav__icon-open" />
      <Icon name="close" size={24} strokeWidth={2} class="nav__icon-close" />
    </button>

    <div class="nav__menu" id="nav-menu">
      <ul class="nav__links">
        {mainNav.map((item) => (
          <li>
            <a class="nav__link" href={item.href} aria-current={item.id === current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary btn--sm nav__cta" href="/contact/">
        Get started
      </a>
    </div>
  </nav>
</header>

<style>
  /* Stays at the top while scrolling, so navigation is always one tap away. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface-200);
    border-bottom: 1px solid var(--hairline);
  }

  @media print {
    .site-header {
      position: static;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 32px;
    padding-block: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(.brand__mark) {
    width: 52px;
    height: 36px;
    object-fit: contain;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 26px;
    letter-spacing: 0.19em;
    color: var(--ink);
  }

  .brand__tagline {
    font-size: 11px;
    line-height: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-left: auto;
  }

  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-block;
    padding: 12px 0;
    color: var(--accent-text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--signal-green), var(--signal-green)) left bottom / 0 2px no-repeat;
    transition:
      background-size 0.25s ease,
      color 0.15s;
  }

  .nav__link:hover {
    color: var(--ink);
    background-size: 100% 2px;
  }

  .nav__link[aria-current='page'] {
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--signal-green);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface-200);
    color: var(--ink);
    cursor: pointer;
  }

  .nav__toggle :global(.nav__icon-close) {
    display: none;
  }

  /* Small phones (320–374 px): shrink the brand so the menu button stays on the same line. */
  @media (max-width: 374px) {
    .brand {
      gap: 8px;
    }

    .brand :global(.brand__mark) {
      width: 40px;
      height: 28px;
    }

    .brand__name {
      font-size: 19px;
      line-height: 22px;
      letter-spacing: 0.14em;
    }

    .brand__tagline {
      font-size: 10px;
      letter-spacing: 0.01em;
    }
  }

  /* Phones and tablets (up to iPad landscape - 1px) use the menu button. */
  @media (max-width: 1023px) {
    .nav {
      gap: 12px;
      padding-block: 12px;
    }

    .nav__toggle {
      display: inline-flex;
    }

    .nav__menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      width: 100%;
      margin-left: 0;
      padding: 4px 0 8px;
      border-top: 1px solid var(--hairline);
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__link {
      display: block;
      padding: 12px 0;
      background: none;
    }

    .nav__link[aria-current='page'] {
      box-shadow: none;
      color: var(--ink);
    }

    .nav__cta {
      width: 100%;
    }

    /* Open menu scrolls inside the screen (matters on phones held sideways). */
    .nav[data-open] .nav__menu {
      display: flex;
      max-height: calc(100dvh - 70px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .nav[data-open] :global(.nav__icon-open) {
      display: none;
    }

    .nav[data-open] :global(.nav__icon-close) {
      display: block;
    }
  }
</style>

<!-- Behaviour lives in src/scripts/nav.ts, loaded once from BaseLayout. -->
