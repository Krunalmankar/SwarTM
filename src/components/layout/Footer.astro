---
import { companyNav, site } from '../../config/site';
import { getServices, servicePath } from '../../lib/content';

const services = await getServices();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer">
    <div class="footer__grid">
      <div class="footer__col">
        <span class="footer__brand">{site.name}</span>
        <span class="footer__muted">{site.tagline}</span>
      </div>

      <nav class="footer__col" aria-labelledby="footer-services">
        <h2 class="footer__heading" id="footer-services">
          Services
        </h2>
        <ul class="footer__list">
          {services.map((service) => (
            <li>
              <a href={servicePath(service)}>{service.data.homeTitle}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-labelledby="footer-company">
        <h2 class="footer__heading" id="footer-company">
          Company
        </h2>
        <ul class="footer__list">
          {companyNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__heading">Get in touch</h2>
        <span>{site.location.display}</span>
        <a class="footer__cta" href="/contact/">
          Book a free session
        </a>
      </div>
    </div>

    <div class="footer__legal">
      <span>
        &copy; {year} {site.legal.copyrightHolder}. All rights reserved.
      </span>
      <a href="/privacy/">Privacy</a>
      <span>{site.legal.trademarkNotice}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--ink-on-dark);
    font-size: 14px;
    line-height: 22px;
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 32px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 32px;
  }

  /* Phones: a compact 2×2 grid instead of one long column. */
  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.19em;
  }

  .footer__muted {
    color: var(--ink-muted-on-dark);
  }

  .footer__heading {
    margin: 0;
    font-size: 12px;
    line-height: 22px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted-on-dark);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--ink-on-dark);
    text-decoration: none;
    transition: color 0.15s;
  }

  a:hover {
    color: var(--signal-green);
  }

  a:focus-visible {
    outline-color: var(--signal-green);
  }

  .footer__cta {
    color: var(--signal-green);
    font-weight: 600;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid var(--hairline-dark);
    font-size: 12px;
    line-height: 16px;
    color: var(--ink-muted-on-dark);
  }

  .footer__legal a {
    color: var(--ink-muted-on-dark);
    text-decoration: underline;
  }
</style>
