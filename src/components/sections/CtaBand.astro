---
import Button from '../ui/Button.astro';

interface Props {
  heading: string;
  text?: string;
  label: string;
  href?: string;
  /** Larger home-page variant. */
  size?: 'md' | 'lg';
  /** Adds the slow orbit and drifting shapes behind the content. */
  decorated?: boolean;
  class?: string;
}

const {
  heading,
  text,
  label,
  href = '/contact/',
  size = 'md',
  decorated = false,
  class: className,
} = Astro.props;
---

<section class:list={['container in-view', className ?? 'pb-96']}>
  <div class:list={['cta-band', `cta-band--${size}`]}>
    {decorated && (
      <>
        <span class="deco deco--orbit orbit" aria-hidden="true">
          <span class="deco__dot" />
        </span>
        <span class="deco deco--blob drift" aria-hidden="true" />
      </>
    )}
    <div class="stack gap-8 measure-620">
      <h2 class={size === 'lg' ? 'display-4' : 'display-3'}>{heading}</h2>
      {text && <p class="on-dark-muted">{text}</p>}
    </div>
    <Button href={href} arrow>
      {label}
    </Button>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 56px 48px;
    border-radius: var(--radius-md);
    background: var(--navy);
    color: var(--ink-on-dark);
  }

  .cta-band--lg {
    gap: 32px;
    padding: 64px 48px;
  }

  .deco {
    position: absolute;
    z-index: -1;
    border-radius: var(--radius-full);
  }

  .deco--orbit {
    right: -90px;
    top: -120px;
    width: 320px;
    height: 320px;
    border: 1px dashed var(--hairline-dark);
  }

  .deco__dot {
    position: absolute;
    left: 30px;
    top: 60px;
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    background: var(--signal-green);
  }

  .deco--blob {
    left: 46%;
    bottom: -60px;
    width: 160px;
    height: 160px;
    background: var(--navy-raised);
  }

  @media (max-width: 600px) {
    .cta-band,
    .cta-band--lg {
      padding: 32px 24px;
    }
  }
</style>
