---
/**
 * Phase timeline. Each bar is an HTML pill positioned with utility classes
 * (multiples of 5%), so the rounded ends never stretch at any screen width and
 * no inline styles are needed (CSP). Bars draw in once when the list scrolls
 * into view (src/scripts/motion.ts); without JavaScript they are simply shown.
 */
interface Phase {
  label: string;
  duration: string;
  /** Start of the bar, 0–95, multiple of 5. */
  start: number;
  /** Length of the bar, 5–100, multiple of 5. */
  width: number;
  tone: 'grey' | 'blue' | 'deep' | 'green';
}

interface Props {
  phases: Phase[];
}

const { phases } = Astro.props;
const snap = (n: number) => Math.round(n / 5) * 5;
---

<ol class="phases" data-reveal>
  {phases.map((phase) => {
    const start = Math.min(Math.max(snap(phase.start), 0), 95);
    const width = Math.min(Math.max(snap(phase.width), 5), 100 - start);
    return (
      <li class="phase">
        <div class="phase__row">
          <span class="fw-600">{phase.label}</span>
          <span class="muted">{phase.duration}</span>
        </div>
        <span class="phase__track" aria-hidden="true">
          <span class:list={['phase__bar', `phase__bar--${phase.tone}`, `start-${start}`, `span-${width}`]} />
        </span>
      </li>
    );
  })}
</ol>

<style>
  .phases {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .phase {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .phase__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 12px;
  }

  .phase__track {
    position: relative;
    display: block;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--node-tint);
  }

  .phase__bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: var(--radius-full);
    clip-path: inset(0 0 0 0 round 9999px);
    transition: clip-path 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Draw in from the left, one bar after another. */
  .phases[data-reveal-pending] .phase__bar {
    clip-path: inset(0 100% 0 0 round 9999px);
  }

  .phase:nth-child(2) .phase__bar {
    transition-delay: 0.12s;
  }
  .phase:nth-child(3) .phase__bar {
    transition-delay: 0.24s;
  }
  .phase:nth-child(n + 4) .phase__bar {
    transition-delay: 0.36s;
  }

  .phase__bar--grey {
    background: var(--connector-grey);
  }
  .phase__bar--blue {
    background: var(--node-blue);
  }
  .phase__bar--deep {
    background: var(--node-deep);
  }
  .phase__bar--green {
    background: var(--signal-green);
  }

  /* Position utilities (percent of the track). */
