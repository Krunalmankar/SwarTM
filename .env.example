# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Live site origin, used for canonical URLs, the sitemap and social previews.
# https only, no trailing slash.
SITE_URL=https://www.swartm.com

# Optional: external booking page (e.g. Calendly) for the "Book a call" buttons.
# Leave empty to send visitors to the contact form instead.
PUBLIC_BOOKING_URL=
